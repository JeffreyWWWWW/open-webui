# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM node:22-alpine3.20 AS build
ARG BUILD_HASH
ENV NODE_OPTIONS="--max-old-space-size=6144"
WORKDIR /app
RUN apk add --no-cache git
COPY package.json package-lock.json ./
RUN npm ci --force
COPY . .
ENV APP_BUILD_HASH=${BUILD_HASH}
RUN npm run build

# Reuse the exact running application and dependency set. This is a branding
# release, independent of the separately prepared v0.12.4 upgrade.
FROM ghcr.io/jeffreywwwww/open-webui:git-89aadda4972191e2bf4846a9c011c0a614d2f6da
ARG BUILD_HASH
ENV WEBUI_NAME="诺宝创智 LLM"
ENV WEBUI_BUILD_HASH=${BUILD_HASH}
COPY --from=build /app/build /app/build
COPY backend/open_webui/config.py backend/open_webui/main.py /app/backend/open_webui/
COPY backend/open_webui/routers/models.py /app/backend/open_webui/routers/models.py
